// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String
  vehicles Vehicle[]

  @@map("brands")
}

enum VehicleResidencyKind {
  residente
  visitante
}

enum VehicleColorKind {
  rojo
  verde
  azul
  amarillo
  negro
  blanco
  gris
  gris_oscuro
  marron
  naranja
}

model Vehicle {
  id          Int                  @id @default(autoincrement())
  plateNumber String               @unique @map("plateNumber")
  brandId     Int                  @map("brandId")
  color       VehicleColorKind     @default(rojo)
  status      VehicleResidencyKind @default(residente)

  brand Brand @relation(fields: [brandId], references: [id])

  @@map("vehicles")
}
