// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String
  vehicles Vehicle[]

  @@map("brands")
}

model Color {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  code     String    @unique
  vehicles Vehicle[]

  @@map("colors")
}

enum VehicleResidencyKind {
  residente
  visitante
}

model Vehicle {
  id          Int                  @id @default(autoincrement())
  plateNumber String               @unique @map("plateNumber")
  brandId     Int                  @map("brandId")
  colorId     Int                  @map("colorId")
  status      VehicleResidencyKind @default(residente)

  brand Brand @relation(fields: [brandId], references: [id])
  color Color @relation(fields: [colorId], references: [id])

  @@map("vehicles")
}
