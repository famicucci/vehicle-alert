# Next + Prisma: copiá a `.env.local`
# Cadena de conexión para Prisma (obligatoria para `prisma generate` / Client)
DATABASE_URL="mysql://root:yourpassword@localhost:3307/vehiclealertdb"

# Opcional: si preferís variables sueltas, podés generar DATABASE_URL a mano
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=yourpassword
DB_NAME=vehiclealertdb
